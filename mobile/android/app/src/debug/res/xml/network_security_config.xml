<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug builds allow private-LAN resolver testing. Dart still rejects
         cleartext public hosts in the Settings screen. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
